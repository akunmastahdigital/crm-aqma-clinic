# Salin ke .env lalu isi. JANGAN commit .env.
# Semua nilai di bawah harus di-provision oleh operator server.

# --- Database (WAJIB) ---
# Database khusus CRM Aqma. Jangan pernah pakai database milik app lain di server ini.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/NAMA_DB_AQMA?schema=public"

# --- Sesi login (WAJIB) ---
# Acak & panjang. Contoh generate: openssl rand -base64 48
JWT_SECRET=""

# --- URL aplikasi ---
NEXT_PUBLIC_APP_URL="https://crm.klinikaqma.com"

# --- Port aplikasi (dipakai npm run dev / start) ---
# Harus port yang belum dipakai app lain di server ini. Dikonfirmasi operator.
PORT=3060

# --- Seeding user awal (hanya dipakai sekali saat setup) ---
SEED_OWNER_EMAIL="owner@klinikaqma.com"
SEED_OWNER_PASSWORD=""
SEED_AGENT_EMAIL="cs@klinikaqma.com"
SEED_AGENT_PASSWORD=""

# --- WhatsApp Cloud API (opsional, isi saat channel disiapkan) ---
WABA_TOKEN=""
META_VERIFY_TOKEN=""
META_APP_SECRET=""

# --- WhatsApp QR via WAHA (opsional) ---
# WAHA jalan sebagai container Docker. Panduan lengkap: docs/setup-waha.md
# PENTING: WAHA memakai penyimpanan file. Jangan arahkan ke database mana pun —
# server ini berisi database milik banyak aplikasi klien lain.
WAHA_URL="http://127.0.0.1:3055"
WAHA_API_KEY=""
# Rahasia header webhook. Endpoint webhook WAHA tidak lewat login karena yang
# memanggil adalah WAHA, bukan browser. Tanpa ini, siapa pun yang tahu URL-nya
# bisa menyuntikkan chat pasien palsu. Generate: openssl rand -hex 32
WAHA_WEBHOOK_SECRET=""

# --- Penyimpanan media ---
# Default di dalam folder project. Jangan arahkan ke web root bersama.
MEDIA_DIR="/root/work/crm-aqma-clinic/uploads"
MEDIA_BASE_URL="/uploads"

# --- Notifikasi Telegram internal (opsional) ---
TELEGRAM_BOT_TOKEN=""

# --- Web push (opsional) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@klinikaqma.com"

# --- AI (opsional) ---
AI_API_KEY=""
